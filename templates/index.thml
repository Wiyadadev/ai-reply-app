<html>
<head>
     <title>AI reply App</title>
</head>
<body>
    <h1>AI Reply</h1>

    <form method="POST">
        <input type="text" name="user_input" placeholder="type something">
        <button type="submit">Send</button>
      </form>

      {% if response %}
          <p><strong>AI:</strong> {{response}}</p>
      {% endif %>
      </body>
      </html>
